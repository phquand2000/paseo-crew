#!/usr/bin/env bash
set -eu

bin=${SEATWORKS_AGENT_BIN:-}
kit=${SEATWORKS_KIT:-}
harness=${SEATWORKS_HARNESS:-}
role=${SEATWORKS_ROLE:-}

run() {
    if [ -z "$bin" ]; then
        echo "Seat room: env.SEATWORKS_AGENT_BIN is unset on this seat's provider; run setup/setup-seats.fish." >&2
        exit 2
    fi
    exec "$bin" ${1+"$@"}
}

manifest=$kit/harness/$harness/harness.json
[ -n "$kit" ] && [ -n "$harness" ] && [ -n "$role" ] && [ -r "$manifest" ] || run ${1+"$@"}
command -v jq >/dev/null 2>&1 || run ${1+"$@"}

repo=$PWD
while [ "$repo" != / ] && [ ! -d "$repo/.seatworks" ]; do repo=$(dirname "$repo"); done
[ -d "$repo/.seatworks" ] || run ${1+"$@"}

project=$repo/.seatworks/project.json
slug=$(jq -r '.slug // empty' "$project" 2>/dev/null || true)
[ -n "$slug" ] || slug=$(basename "$repo")

root=$(jq -r '.profileRoot // empty' "$manifest" 2>/dev/null || true)
[ -n "$root" ] || run ${1+"$@"}
case $root in HOME/*) root=$HOME/${root#HOME/} ;; esac
dir=$root/$role-$slug
[ -d "$dir" ] || run ${1+"$@"}

export SEATWORKS_REPO=$repo
export SEATWORKS_SLUG=$slug
export SEATWORKS_SEAT=$role-$slug

var=$(jq -r '.configDirEnv // empty' "$manifest" 2>/dev/null || true)
[ -n "$var" ] && export "$var=$dir"

materialize=$(jq -r '.settings.materialize // empty' "$manifest" 2>/dev/null || true)
if [ -n "$materialize" ] && [ -x "$kit/harness/$harness/$materialize" ]; then
    "$kit/harness/$harness/$materialize" "$role-$slug" "$role" "$dir" >&2
fi

model=$(jq -r --arg r "$role" '.models[$r] // empty' "$project" 2>/dev/null || true)
if [ -n "$model" ]; then
    args=()
    swap=0
    for arg in ${1+"$@"}; do
        if [ "$swap" = 1 ]; then
            args+=("$model")
            swap=0
            continue
        fi
        args+=("$arg")
        [ "$arg" = --model ] && swap=1
    done
    set -- ${args[@]+"${args[@]}"}
fi

run ${1+"$@"}
