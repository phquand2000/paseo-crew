#!/usr/bin/env python3
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

OVERLAY_KEYS = {
    "model",
    "model_provider",
    "model_reasoning_effort",
    "model_reasoning_summary",
    "model_verbosity",
    "model_catalog_json",
    "sandbox_mode",
    "approval_policy",
    "approvals_reviewer",
}


def fail(message):
    raise SystemExit(f"! codex room: {message}")


def top_level_table_offset(text):
    match = re.search(r"(?m)^\[", text)
    return match.start() if match else len(text)


def block(text, key):
    match = re.search(rf'(?ms)^{key}\s*=\s*""".*?^"""\s*$', text)
    return match.group(0).rstrip() + "\n" if match else ""


def scalars(text, keys):
    values = {}
    for line in text[: top_level_table_offset(text)].splitlines():
        match = re.match(r"^([A-Za-z0-9_]+)\s*=\s*(.+)$", line)
        if match and match.group(1) in keys:
            values[match.group(1)] = match.group(2)
    return values


def tables(text):
    return text[top_level_table_offset(text):]


def apply_scalars(head, values):
    rendered = []
    seen = set()
    for line in head.rstrip().splitlines():
        match = re.match(r"^([A-Za-z0-9_]+)\s*=", line)
        if match and match.group(1) in values:
            rendered.append(f"{match.group(1)} = {values[match.group(1)]}")
            seen.add(match.group(1))
        else:
            rendered.append(line)
    for key, value in values.items():
        if key not in seen:
            rendered.append(f"{key} = {value}")
    return "\n".join(rendered).rstrip() + "\n\n"


def write_atomic(path, text):
    handle, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    with os.fdopen(handle, "w") as stream:
        stream.write(text)
    os.replace(temporary, path)


def link(runtime, name, target):
    path = runtime / name
    if not target.exists():
        if path.is_symlink():
            path.unlink()
        return False
    if path.is_symlink() and pathlib.Path(os.readlink(path)) == target:
        return True
    if path.is_dir() and not path.is_symlink():
        fail(f"{path} is a real directory; the room links that name, so move it aside and rerun")
    if path.exists() or path.is_symlink():
        path.unlink()
    path.symlink_to(target)
    return True


def substitute(text, values):
    for key in sorted(values, key=len, reverse=True):
        text = text.replace(key, values[key])
    return text


def unresolved(text, path):
    left = sorted(set(re.findall(r"\b(?:MODEL|PROVIDER|CODEX|SEAT)_[A-Z_]+\b", text)))
    if left:
        fail(f"{path} still holds unfilled placeholders: {', '.join(left)}")


def bundled_models(codex):
    if not codex:
        return []
    try:
        result = subprocess.run(
            [codex, "debug", "models", "--bundled"],
            check=True, capture_output=True, text=True, timeout=60,
        )
    except (subprocess.SubprocessError, OSError):
        return []
    try:
        return json.loads(result.stdout).get("models") or []
    except json.JSONDecodeError:
        return []


def build_catalog(kit, runtime, values, codex, keep_bundled):
    source = json.loads((kit / "harness/codex/models.json").read_text())
    models = json.loads(substitute(json.dumps(source), values))["models"]
    slugs = {model.get("slug") for model in models}
    if keep_bundled:
        for model in bundled_models(codex):
            if isinstance(model, dict) and model.get("slug") not in slugs:
                models.append(model)
    for model in models:
        if not isinstance(model, dict):
            fail("the model catalog holds an entry that is not an object")
        model["multi_agent_version"] = None
    target = runtime / "model-catalog.json"
    write_atomic(target, json.dumps({"models": models}, separators=(",", ":")) + "\n")
    return target


def main():
    if len(sys.argv) != 4:
        raise SystemExit(f"usage: {sys.argv[0]} SEAT ROLE RUNTIME_DIR")
    seat, role, runtime = sys.argv[1], sys.argv[2], pathlib.Path(sys.argv[3])
    kit = pathlib.Path(os.environ.get("SEATWORKS_KIT", ""))
    if not (kit / "harness/codex/harness.json").is_file():
        fail("SEATWORKS_KIT is not set to the kit directory")

    manifest = json.loads((kit / "harness/codex/harness.json").read_text())
    canonical = pathlib.Path(
        os.path.expanduser(manifest["settings"]["baseline"].replace("HOME", "~", 1))
    ).parent
    runtime.mkdir(parents=True, exist_ok=True)

    model = os.environ.get("SEATWORKS_CODEX_MODEL", "")
    provider = os.environ.get("SEATWORKS_CODEX_PROVIDER", "")
    if not model or not provider:
        fail("set SEATWORKS_CODEX_MODEL and SEATWORKS_CODEX_PROVIDER on this seat's provider")

    values = {
        "MODEL_ID": model,
        "MODEL_DESCRIPTION": os.environ.get("SEATWORKS_CODEX_MODEL_DESCRIPTION", model),
        "PROVIDER_NAME": provider,
        "PROVIDER_BASE_URL": os.environ.get("SEATWORKS_CODEX_BASE_URL", ""),
        "PROVIDER_ENV_KEY": os.environ.get("SEATWORKS_CODEX_ENV_KEY", ""),
        "PROVIDER_WIRE_API": os.environ.get("SEATWORKS_CODEX_WIRE_API", "responses"),
    }

    codex = os.environ.get("CODEX_BIN") or shutil.which("codex")
    keep = os.environ.get("SEATWORKS_CODEX_KEEP_BUNDLED", "") == "1"
    catalog = build_catalog(kit, runtime, values, codex, keep)
    values["CODEX_MODEL_CATALOG"] = json.dumps(str(catalog))[1:-1]

    kit_base = substitute((kit / "harness/codex/config/base.config.toml").read_text(), values)
    unresolved(kit_base, "harness/codex/config/base.config.toml")

    overlay_path = kit / "harness/codex/config" / f"{role}.config.toml"
    if not overlay_path.is_file():
        fail(f"no role overlay at harness/codex/config/{role}.config.toml; write one for {role}")
    overlay = substitute(overlay_path.read_text(), values)

    user_base = canonical / "config.toml"
    shared = user_base.read_text() if user_base.is_file() else ""

    head = apply_scalars(
        text_head(shared) + text_head(kit_base),
        {**scalars(kit_base, OVERLAY_KEYS), **scalars(overlay, OVERLAY_KEYS)},
    )
    instructions = block(overlay, "developer_instructions") or block(kit_base, "developer_instructions")
    body = tables(shared).lstrip() + ("\n" if tables(shared).strip() else "") + tables(kit_base).lstrip()
    merged = head + (instructions + "\n" if instructions else "") + body
    write_atomic(runtime / "config.toml", merged)

    linked = []
    for entry in manifest.get("links") or []:
        name = entry["link"]
        target = pathlib.Path(os.path.expanduser(entry["target"].replace("HOME", "~", 1)))
        if link(runtime, name, target):
            linked.append(name)
        elif entry.get("required"):
            fail(f"{target} not found; {entry['required']}")

    print(f"  ~ {seat}: {runtime}/config.toml, model-catalog.json"
          + (f", links {', '.join(linked)}" if linked else ""))


def text_head(text):
    return text[: top_level_table_offset(text)]


if __name__ == "__main__":
    main()
