{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": false
  },
  "autoCompactWindow": 300000,
  "precomputeCompactionEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "workflowKeywordTriggerEnabled": false,
  "disableWorkflows": true,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "language": "vietnamese",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "outputStyle": "Concise",
  "disableBundledSkills": true,
  "askUserQuestionTimeout": "never",
  "promptCacheTtl": "1h",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_CONFIG_DIR/lead-guard.sh\"; if [ -x \"$f\" ]; then exec \"$f\"; fi; echo \"Lead guard: lead-guard.sh is missing from this seat profile; run setup/setup-seats.fish.\" >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "mcp__paseo__create_agent|mcp__paseo__update_agent|mcp__paseo__set_agent_mode|mcp__paseo__send_agent_prompt|mcp__paseo__create_schedule|mcp__paseo__update_schedule",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_CONFIG_DIR/profile-guard.sh\"; if [ -x \"$f\" ]; then exec \"$f\"; fi; echo \"Profile guard: profile-guard.sh is missing from this seat profile; run setup/setup-seats.fish.\" >&2; exit 2"
          }
        ]
      }
    ]
  }
}
