{
  "permission": {
    "edit": "deny",
    "webfetch": "deny",
    "task": "allow",
    "bash": {
      "git add*": "deny",
      "git commit*": "deny",
      "git rm*": "deny",
      "git mv*": "deny",
      "git restore*": "deny",
      "git revert*": "deny",
      "git clean*": "deny",
      "git apply*": "deny",
      "git am*": "deny",
      "git config*": "deny",
      "git pull*": "deny",
      "git -C * add*": "deny",
      "git -C * commit*": "deny",
      "git -C * rm*": "deny",
      "git -C * mv*": "deny",
      "git -C * restore*": "deny",
      "git -C * revert*": "deny",
      "git -C * clean*": "deny",
      "git -C * apply*": "deny",
      "git -C * am*": "deny",
      "git -C * config*": "deny",
      "git -C * pull*": "deny"
    }
  }
}
