{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "task": "deny",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git -C * push*": "deny",
      "gh *": "deny",
      "paseo *": "deny",
      "claude*": "deny",
      "npx claude*": "deny",
      "bunx claude*": "deny",
      "codex*": "deny",
      "npx codex*": "deny",
      "opencode*": "deny",
      "npx opencode*": "deny",
      "agy*": "deny",
      "git merge*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git update-ref*": "deny",
      "git branch -f*": "deny",
      "git branch -D*": "deny",
      "git cherry-pick*": "deny",
      "git stash*": "deny",
      "git worktree*": "deny",
      "git -C * merge*": "deny",
      "git -C * checkout*": "deny",
      "git -C * switch*": "deny",
      "git -C * reset*": "deny",
      "git -C * rebase*": "deny",
      "git -C * update-ref*": "deny",
      "git -C * branch -f*": "deny",
      "git -C * branch -D*": "deny",
      "git -C * cherry-pick*": "deny",
      "git -C * stash*": "deny",
      "git -C * worktree*": "deny"
    }
  }
}
