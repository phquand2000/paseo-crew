prefix_rule(pattern = ["git", ["add", "commit", "rm", "mv", "restore", "revert", "clean", "apply", "am", "config"]], decision = "forbidden", justification = "The Advisor reads; it changes nothing.")
prefix_rule(pattern = ["git", ["merge", "reset", "rebase", "cherry-pick"]], decision = "forbidden", justification = "The Advisor reads; it moves no branch.")
