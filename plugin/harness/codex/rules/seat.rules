prefix_rule(pattern = ["git", "push"], decision = "forbidden", justification = "Branches are landed for you; do not push.")
prefix_rule(pattern = ["git", ["pull", "switch", "update-ref"]], decision = "forbidden", justification = "Branches and working copies are managed for you.")
prefix_rule(pattern = ["git", "checkout"], decision = "forbidden", justification = "Branches and working copies are managed for you; for one file, run git restore --source=<commit> -- <path>, or git show <commit>:<path> to read it.")
prefix_rule(pattern = ["git", "stash"], decision = "forbidden", justification = "Branches and working copies are managed for you; to read a stash, run git log -g refs/stash or git show stash@{<n>}.")
prefix_rule(pattern = ["git", "worktree", ["add", "lock", "move", "prune", "remove", "repair", "unlock"]], decision = "forbidden", justification = "Working copies are managed for you.")
prefix_rule(pattern = ["git", "branch", ["-f", "-D", "--force"]], decision = "forbidden", justification = "Branches are managed for you.")
prefix_rule(pattern = ["gh"], decision = "forbidden", justification = "The forge is reached for you, not from a shell.")
prefix_rule(pattern = ["paseo"], decision = "forbidden", justification = "Agents are started and stopped for you, not from a shell.")
prefix_rule(pattern = [["claude", "codex", "opencode", "omp", "devin", "pi"]], decision = "forbidden", justification = "Agents are started for you, not from a shell.")
prefix_rule(pattern = [["npx", "bunx"], ["claude", "codex", "opencode", "omp"]], decision = "forbidden", justification = "Agents are started for you, not from a shell.")
