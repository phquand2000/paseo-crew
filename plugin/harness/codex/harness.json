{
  "id": "codex",
  "label": "Codex",
  "baseProvider": "codex",
  "profileRoot": "HOME/.codex/seats",
  "configDirEnv": "CODEX_HOME",
  "contextFile": "AGENTS.md",
  "skillsDir": "skills",
  "steers": true,
  "systemPrompt": "config",
  "hideSkills": {
    "roots": [
      "HOME/.agents/skills"
    ],
    "setting": "skills.config"
  },
  "mcp": {
    "file": "config.toml",
    "delivery": "launch",
    "preapprove": true,
    "transports": [
      "stdio",
      "http"
    ]
  },
  "settings": {
    "file": "config.toml",
    "source": "settings.toml",
    "roleSource": "settings/ROLE.settings.toml",
    "inherits": {
      "from": "HOME/.codex/config.toml",
      "keys": [
        "model_provider",
        "model_providers"
      ]
    }
  },
  "stateWrites": {
    "path": "sandbox_workspace_write.writable_roots",
    "delivery": "file"
  },
  "files": {
    "rules/paseo-crew.rules": [
      "rules/seat.rules",
      "rules/ROLE.rules"
    ]
  },
  "modelCatalog": {
    "command": [
      "codex",
      "debug",
      "models",
      "--bundled"
    ],
    "list": "models",
    "clear": [
      "multi_agent_version"
    ],
    "file": "model-catalog.json",
    "setting": "model_catalog_json"
  },
  "links": [
    {
      "link": "auth.json",
      "target": "HOME/.codex/auth.json"
    }
  ],
  "checks": [
    {
      "path": "HOME/.codex/auth.json",
      "help": "Log in with `codex login` once, outside any seat; every Codex seat shares that login."
    }
  ],
  "provider": {
    "env": {
      "PASEO_CREW_HARNESS": "codex",
      "PASEO_CREW_AGENT_BIN": "codex"
    }
  }
}
