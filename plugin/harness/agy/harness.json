{
  "id": "agy",
  "label": "Antigravity",
  "baseProvider": "acp",
  "profileRoot": "HOME/.gemini/seats",
  "configDirEnv": "PASEO_CREW_AGY_HOME",
  "promptFile": ".gemini/GEMINI.md",
  "skillsDir": ".gemini/config/skills",
  "hasThinking": false,
  "systemPrompt": "file",
  "mcp": {
    "file": ".gemini/config/mcp_config.json",
    "delivery": "file",
    "key": "mcpServers",
    "transports": [
      "stdio",
      "http"
    ]
  },
  "settings": {
    "file": ".gemini/config/paseo-crew.json",
    "source": "settings.json",
    "roleSource": "settings/ROLE.settings.json"
  },
  "links": [
    {
      "link": ".gemini/antigravity-cli/antigravity-oauth-token",
      "target": "HOME/.gemini/antigravity-cli/antigravity-oauth-token"
    },
    {
      "link": ".gitconfig",
      "target": "HOME/.gitconfig",
      "optional": true
    },
    {
      "link": ".config/git",
      "target": "HOME/.config/git",
      "optional": true
    }
  ],
  "checks": [
    {
      "path": "HOME/.gemini/antigravity-cli/antigravity-oauth-token",
      "help": "Sign in to `agy` once, outside any seat; every Antigravity seat shares that login."
    }
  ],
  "provider": {
    "env": {
      "AGY_EXTRA_ARGS": "--dangerously-skip-permissions",
      "AGY_PRINT_TIMEOUT": "45m",
      "PASEO_CREW_HARNESS": "agy",
      "PASEO_CREW_AGENT_BIN": "agy-acp"
    },
    "command": [
      "KIT/bin/agy-home"
    ]
  }
}
