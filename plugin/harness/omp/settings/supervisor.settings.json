{
  "bash": {
    "patterns": [
      {
        "match": "git commit",
        "approval": "deny"
      },
      {
        "match": "git commit *",
        "approval": "deny"
      },
      {
        "match": "git -C * commit",
        "approval": "deny"
      },
      {
        "match": "git -C * commit *",
        "approval": "deny"
      },
      {
        "match": "sleep *",
        "approval": "deny"
      }
    ]
  }
}
