{
  "id": "omp",
  "label": "Oh My Pi",
  "baseProvider": "omp",
  "profileRoot": "HOME/.omp/seats",
  "configDirEnv": "PI_CODING_AGENT_DIR",
  "contextFile": "AGENTS.md",
  "skillsDir": "skills",
  "mcp": {
    "file": "mcp.json",
    "delivery": "file",
    "key": "mcpServers",
    "transports": [
      "stdio",
      "http",
      "sse"
    ]
  },
  "mcpCall": "^mcp__{server}_",
  "settings": {
    "file": "config.yml",
    "source": "settings.json",
    "roleSource": "settings/ROLE.settings.json",
    "overlayEnv": "PI_CONFIG_FILES"
  },
  "links": [
    {
      "link": "agent.db",
      "target": "HOME/.omp/agent/agent.db"
    },
    {
      "link": "models.yml",
      "target": "HOME/.omp/agent/models.yml",
      "optional": true
    }
  ],
  "checks": [
    {
      "path": "HOME/.omp/agent/agent.db",
      "help": "Log in with omp once, outside any seat; every omp seat shares that login."
    }
  ],
  "provider": {
    "env": {
      "SEATWORKS_HARNESS": "omp",
      "SEATWORKS_AGENT_BIN": "omp"
    },
    "profileModeId": "full"
  }
}
