{
  "permissions": {
    "deny": [
      "Edit",
      "Write",
      "MultiEdit",
      "WebSearch",
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git restore *)",
      "Bash(git revert *)",
      "Bash(git clean *)",
      "Bash(git apply *)",
      "Bash(git am *)",
      "Bash(git config *)",
      "Bash(git -C * add *)",
      "Bash(git -C * rm *)",
      "Bash(git -C * mv *)",
      "Bash(git -C * restore *)",
      "Bash(git -C * revert *)",
      "Bash(git -C * clean *)",
      "Bash(git -C * apply *)",
      "Bash(git -C * config *)"
    ]
  },
  "sandbox": {
    "network": {
      "allowLocalBinding": true
    }
  }
}
