{
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Edit(./**)",
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(sleep *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git -C * merge *)",
      "Bash(git -C * reset *)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * cherry-pick *)"
    ]
  },
  "sandbox": {
    "network": {
      "allowLocalBinding": true
    }
  }
}
