{
  "autoCompactWindow": 200000,
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Edit(./**)",
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(sleep *)"
    ]
  },
  "sandbox": {
    "network": {
      "allowLocalBinding": true
    }
  }
}
