{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Agent",
      "Workflow",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "SendMessage",
      "ListAgents",
      "Monitor",
      "TaskOutput",
      "TaskStop",
      "PushNotification",
      "ReportFindings",
      "Artifact",
      "DesignSync",
      "Bash(gh *)",
      "Bash(paseo *)",
      "Bash(claude *)",
      "Bash(npx claude *)",
      "Bash(bunx claude *)",
      "Bash(codex *)",
      "Bash(opencode *)",
      "Bash(omp *)",
      "Bash(pi *)",
      "Edit(~/.paseo/**)",
      "Read(~/.paseo/config.json)",
      "Read(~/.paseo/config.json*)",
      "Edit(~/.claude/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.codex/**)",
      "Read(~/.codex/**)",
      "Read(~/.codex/auth.json)",
      "Edit(~/.pi/**)",
      "Read(~/.pi/**)",
      "Read(~/.pi/agent/auth.json)",
      "Edit(~/.omp/**)",
      "Read(~/.omp/**)",
      "Read(~/.omp/agent/agent.db)",
      "Edit(~/.config/opencode/**)",
      "Read(~/.config/opencode/**)",
      "Edit(~/.config/opencode-seats/**)",
      "Read(~/.config/opencode-seats/**)",
      "Edit(~/.local/share/opencode/**)",
      "Read(~/.local/share/opencode/**)",
      "Read(~/.local/share/opencode/auth.json)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Read(~/.aws/**)",
      "Edit(~/.kube/**)",
      "Read(~/.kube/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)",
      "Edit(~/.local/share/paseo-crew/settings.json)",
      "Read(~/.local/share/paseo-crew/settings.json)",
      "Read(~/.local/share/paseo-crew/settings.json*)",
      "Edit(~/.local/share/paseo-crew/outbox.json)",
      "Edit(~/.local/share/paseo-crew/intents.json)",
      "Edit(~/.local/share/paseo-crew/kit.json)",
      "Edit(~/.local/share/paseo-crew/content.json)",
      "Edit(~/.local/share/paseo-crew/models.json)",
      "Edit(~/.local/share/paseo-crew/bin/**)",
      "Edit(~/.local/share/paseo-crew/keys.json)",
      "Read(~/.local/share/paseo-crew/keys.json*)",
      "Edit(~/.local/share/paseo-crew/content/**)",
      "Edit(~/.local/share/paseo-crew/guides/**)",
      "Edit(~/.local/share/paseo-crew/projects/*/ledger.json)",
      "Edit(~/.local/share/paseo-crew/projects/*/incidents.json)",
      "Edit(~/.local/share/paseo-crew/projects/*/project.json)",
      "Edit(~/.local/share/paseo-crew/projects/*/meta.json)",
      "Edit(~/.local/share/paseo-crew/projects/*/settings.json)",
      "Read(~/.local/share/paseo-crew/projects/*/settings.json*)",
      "Edit(~/.local/share/paseo-crew/projects/*/status.md)",
      "Edit(~/.local/share/paseo-crew/projects/*/events.log)",
      "Edit(~/.local/share/paseo-crew/projects/*/attention.log)",
      "Edit(~/.local/share/paseo-crew/projects/*/assessments.log)",
      "Edit(~/.local/share/paseo-crew/projects/*/handbacks/**)",
      "Edit(~/.local/share/paseo-crew/projects/*/gates/**)",
      "Edit(~/.local/share/paseo-crew/projects/*/archive/**)",
      "Edit(~/.local/share/paseo-crew/projects/*/events.*.log*)",
      "Edit(~/.local/share/paseo-crew/projects/*/attention.*.log*)",
      "Edit(~/.local/share/paseo-crew/projects/*/assessments.*.log*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false
  },
  "autoCompactWindow": 558000,
  "precomputeCompactionEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "disableWorkflows": true,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "language": "vietnamese",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "outputStyle": "Concise",
  "disableBundledSkills": true
}
