{
  "id": "claude",
  "label": "Claude Code",
  "baseProvider": "claude",
  "profileRoot": "HOME/.claude/profiles",
  "configDirEnv": "CLAUDE_CONFIG_DIR",
  "promptFile": "CLAUDE.md",
  "skillsDir": "skills",
  "steers": true,
  "models": [
    {
      "id": "claude-opus-5",
      "label": "Opus 5",
      "thinkingOptions": [
        {
          "id": "medium",
          "label": "Medium"
        },
        {
          "id": "high",
          "label": "High"
        }
      ]
    }
  ],
  "mcp": {
    "file": ".claude.json",
    "delivery": "launch",
    "transports": [
      "stdio",
      "http",
      "sse"
    ],
    "seed": {
      "hasCompletedOnboarding": true
    },
    "clear": {
      "set": {
        "mcpServers": {},
        "enabledMcpjsonServers": []
      },
      "remove": [
        "enableAllProjectMcpServers"
      ],
      "setInEach": {
        "projects": {
          "mcpServers": {}
        }
      }
    }
  },
  "settings": {
    "file": "settings.json",
    "source": "settings.json",
    "roleSource": "settings/ROLE.settings.json"
  },
  "links": [
    {
      "link": "projects",
      "target": "HOME/.claude/projects"
    }
  ],
  "provider": {
    "env": {
      "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
      "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
      "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
      "SEATWORKS_HARNESS": "claude",
      "SEATWORKS_AGENT_BIN": "claude",
      "ENABLE_TOOL_SEARCH": "false",
      "ENABLE_PROMPT_CACHING_1H": "1"
    },
    "profileModeId": "bypassPermissions",
    "command": [
      "KIT/bin/seat-room"
    ],
    "forceFlags": {
      "--setting-sources": "user"
    }
  },
  "contextFile": "CLAUDE.md",
  "systemPrompt": "config",
  "stateWrites": {
    "path": "settings.sandbox.filesystem.allowWrite",
    "delivery": "launch"
  }
}
