{
  "serialOnly": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "Cargo.lock",
    "go.sum",
    "**/migrations/**",
    "**/db/migrate/**",
    "ProjectSettings/**",
    "Packages/manifest.json",
    "**/*.unity",
    "**/*.prefab",
    "**/*.asset",
    "**/*.uasset",
    "**/*.umap",
    "**/*.pbxproj",
    "**/*.csproj",
    "**/*.sln"
  ],
  "riskRules": [
    {
      "paths": [
        "**/migration/**",
        "**/migrations/**",
        "**/migrate/**",
        "**/schema/**",
        "**/schema.*",
        "**/*.sql"
      ],
      "invariant": "running it a second time changes nothing, and the data from before can be got back",
      "reviewQuestion": "What does running this a second time do to data it already changed, and how is the data from before got back if it goes wrong?"
    }
  ],
  "gates": [
    {
      "files": [
        "package.json"
      ],
      "script": "test",
      "run": "npm test",
      "lockfiles": {
        "pnpm-lock.yaml": "pnpm test",
        "yarn.lock": "yarn test",
        "bun.lock": "bun run test",
        "bun.lockb": "bun run test"
      }
    },
    {
      "files": [
        "mvnw"
      ],
      "run": "./mvnw -q test"
    },
    {
      "files": [
        "pom.xml"
      ],
      "run": "mvn -q test"
    },
    {
      "files": [
        "gradlew"
      ],
      "run": "./gradlew test"
    },
    {
      "files": [
        "Cargo.toml"
      ],
      "run": "cargo test"
    },
    {
      "files": [
        "go.mod"
      ],
      "run": "go test ./..."
    },
    {
      "files": [
        "pyproject.toml",
        "pytest.ini"
      ],
      "run": "pytest -q"
    }
  ],
  "scriptRunners": [
    "npm",
    "pnpm",
    "yarn",
    "bun"
  ],
  "unsetScript": "no test specified",
  "files": {
    "test": "(^|/)(tests?|__tests__|spec|specs)/|\\.(test|spec)\\.[a-z0-9]+$|(?-i:(Test|Tests|IT)\\.(java|kt|scala|cs))$|(?-i:_test\\.(go|py|rb))$|(?-i:(^|/)test_[^/]+\\.py)$",
    "docs": "\\.(md|mdx|txt|rst|adoc)$|(^|/)docs?/"
  },
  "watch": {
    "destructive": "(?:^|[;&|(`{\\n]|\\$\\(|\\b(?:sudo|xargs|exec|env|nohup|time|command|then|do|else)\\s+|-exec(?:dir)?\\s+|\\b(?:ba|z)?sh\\s+-l?c\\s+)\\s*['\"]?(?:rm\\s+(?:-\\S+\\s+)*(?:-[a-z]*[rf][a-z]*|--(?:recursive|force)\\b)|git\\s+(?:-C\\s+\\S+\\s+)?(?:reset\\s+--hard|clean\\s+-[a-z]*f|push\\s+[^|;&]*(?:--force|-f)\\b|branch\\s+(?:-\\S+\\s+)*(?-i:-D)\\b|branch\\b(?=[^|;&]*\\s(?:-[a-z]*d|--delete))[^|;&]*\\s(?:-[a-z]*f|--force)\\b))|--force-with-lease|\\bdrop\\s+(?:table|database)\\b|\\btruncate\\s+table\\b",
    "testPath": "(^|/)(tests?|specs?|__tests__)/|[._-](test|spec)\\.[a-z]+$|(^|/)test_[^/]*\\.[a-z]+$",
    "suppressed": "@ts-ignore|@ts-expect-error|@ts-nocheck|eslint-disable|#\\s*type:\\s*ignore|#\\s*noqa|\\bas\\s+any\\b(?![ \\t]+(?!as\\b)[a-z])",
    "skipped": "\\.(skip|only|todo)\\b|\\bx(it|describe|test)\\b|@Disabled\\b|pytest\\.mark\\.skip\\b",
    "assertion": "\\b(assert|expect)\\b|\\.should\\b",
    "refused": "permission|denied|not allowed|refused|blocked by",
    "runners": [
      "npm",
      "pnpm",
      "yarn",
      "bun",
      "npx",
      "bunx",
      "uv",
      "uvx",
      "poetry",
      "pipenv",
      "python",
      "python3",
      "cargo",
      "go",
      "make",
      "just",
      "deno",
      "node",
      "dotnet",
      "mvn",
      "gradle",
      "./gradlew",
      "git",
      "gh",
      "docker",
      "kubectl"
    ]
  }
}
