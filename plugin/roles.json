{
  "providerPrefix": "sw2-",
  "attention": {
    "tickSeconds": 30,
    "leadIdleMinutes": 12,
    "askRemindMinutes": 15,
    "maxReminders": 2,
    "judge": "off"
  },
  "roles": [
    {
      "role": "supervisor",
      "label": "Supervisor",
      "description": "Works with the Human, decides everything short of the concept, opens lanes and answers Leads",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "supervise"
      ],
      "tools": "supervisor",
      "prompt": "prompts/SUPERVISOR.md",
      "skills": "supervisor",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": [
        "CONTEXT.md",
        "notebook.md",
        "pre-mortem/",
        "architecture-premise-audit/"
      ]
    },
    {
      "role": "lead",
      "label": "Lead",
      "description": "Owns a lane: splits it into tasks, starts Peers, accepts and integrates; stays on after it closes until released",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "lead",
        "watched"
      ],
      "tools": "lead",
      "prompt": "prompts/LEAD.md",
      "skills": "lead",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "supervisor"
      ],
      "writes": [
        "plans/",
        "council/",
        "ultra-review/",
        "repo-refresh/"
      ]
    },
    {
      "role": "peer",
      "label": "Peer",
      "description": "Does its Lead's tasks one at a time and hands each back",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "work",
        "write",
        "watched"
      ],
      "tools": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "backup-peer",
      "label": "Backup Peer",
      "description": "Does a Peer's task on another agent, for when the Peer's is out of quota",
      "defaults": {
        "harness": "codex",
        "model": "gpt-5.6-luna",
        "thinking": "max"
      },
      "can": [
        "work",
        "write",
        "watched"
      ],
      "tools": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "reviewer",
      "label": "Reviewer",
      "description": "Read-only Peer that reviews a task branch with clean context",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "peer:test-proof-debt-audit",
        "peer:security-check"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "senior-reviewer",
      "label": "Senior Reviewer",
      "description": "Read-only Peer that reviews complex changes and a lane before it closes, on a stronger model",
      "defaults": {
        "harness": "codex",
        "model": "gpt-6-astra",
        "thinking": "xhigh"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "peer:test-proof-debt-audit",
        "peer:security-check"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "watcher",
      "label": "Watcher",
      "description": "Answers the watch's questions about one moment of the work at a time, from what the desk read then; it cannot touch the work",
      "follows": "peer",
      "can": [
        "judge"
      ],
      "tools": "watcher",
      "prompt": "prompts/WATCHER.md",
      "skills": null,
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": []
    },
    {
      "role": "pager",
      "label": "Pager",
      "description": "Carries a page to the Human: says back the lines the desk gives it, and Paseo pushes them to their phone",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "low"
      },
      "can": [
        "page"
      ],
      "prompt": "prompts/PAGER.md",
      "skills": null,
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": []
    }
  ]
}
