{
  "providerPrefix": "sw2-",
  "limits": {
    "slots": 3,
    "tasksPerLane": 4
  },
  "code": {
    "ide": "http://127.0.0.1:29170/index-mcp/streamable-http",
    "semble": [
      "uvx",
      "--from",
      "semble[mcp]==0.5.4",
      "semble"
    ]
  },
  "attention": {
    "tickSeconds": 30,
    "leadIdleMinutes": 12,
    "askRemindMinutes": 15,
    "maxReminders": 2,
    "watcherDebounceSeconds": 45,
    "watcherTimeoutSeconds": 180
  },
  "mcpServers": {},
  "roles": [
    {
      "role": "supervisor",
      "label": "Supervisor",
      "description": "Works with the Human, decides everything short of the concept, opens lanes and answers Leads",
      "entry": true,
      "harness": "claude",
      "team": "supervisor",
      "byHarness": {
        "claude": {
          "models": [
            {
              "id": "claude-opus-5",
              "label": "Opus 5",
              "isDefault": true,
              "thinkingOptions": [
                {
                  "id": "medium",
                  "label": "Medium"
                },
                {
                  "id": "high",
                  "label": "High",
                  "isDefault": true
                }
              ]
            }
          ]
        }
      },
      "prompt": "prompts/SUPERVISOR.md",
      "codeTools": [
        "search",
        "find_related",
        "ide_find_symbol",
        "ide_find_references",
        "ide_type_hierarchy",
        "ide_call_hierarchy",
        "ide_file_structure"
      ],
      "skills": "supervisor",
      "extraMcpServers": {
        "figma": {
          "type": "http",
          "url": "https://mcp.figma.com/mcp"
        }
      },
      "paseoTools": {
        "allow": [
          "get_agent_activity",
          "list_pending_permissions"
        ]
      },
      "hidesWords": []
    },
    {
      "role": "lead",
      "label": "Lead",
      "description": "Owns one lane: splits it into tasks, starts Peers, accepts and integrates",
      "harness": "claude",
      "team": "lead",
      "byHarness": {
        "claude": {
          "models": [
            {
              "id": "claude-opus-5",
              "label": "Opus 5",
              "isDefault": true,
              "thinkingOptions": [
                {
                  "id": "medium",
                  "label": "Medium",
                  "isDefault": true
                },
                {
                  "id": "high",
                  "label": "High"
                }
              ]
            }
          ]
        }
      },
      "prompt": "prompts/LEAD.md",
      "codeTools": [
        "search",
        "find_related",
        "ide_find_definition",
        "ide_find_references",
        "ide_find_implementations",
        "ide_call_hierarchy",
        "ide_type_hierarchy",
        "ide_find_symbol",
        "ide_symbol_info",
        "ide_file_structure",
        "ide_diagnostics",
        "ide_sync_files"
      ],
      "skills": "lead",
      "extraMcpServers": {
        "figma": {
          "type": "http",
          "url": "https://mcp.figma.com/mcp"
        }
      },
      "paseoTools": {
        "allow": [
          "get_agent_activity"
        ]
      },
      "hidesWords": [
        "supervisor",
        "watcher"
      ]
    },
    {
      "role": "peer",
      "label": "Peer",
      "description": "Does one task on its own branch and hands it back",
      "harness": "devin",
      "team": "peer",
      "byHarness": {
        "devin": {
          "models": [
            {
              "id": "swe-2-max",
              "label": "SWE-2 Max",
              "isDefault": true
            }
          ]
        },
        "omp": {
          "models": [
            {
              "id": "zai/glm-5.3-flash",
              "label": "GLM-5.3-Flash",
              "isDefault": true
            }
          ],
          "thinking": "max"
        }
      },
      "prompt": "prompts/PEER.md",
      "codeTools": [
        "search",
        "find_related",
        "ide_find_definition",
        "ide_find_references",
        "ide_find_implementations",
        "ide_call_hierarchy",
        "ide_type_hierarchy",
        "ide_find_symbol",
        "ide_symbol_info",
        "ide_file_structure",
        "ide_diagnostics",
        "ide_sync_files",
        "ide_find_super_methods",
        "ide_refactor_rename",
        "ide_move_file",
        "ide_refactor_safe_delete"
      ],
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "watcher",
        "seat",
        "seats"
