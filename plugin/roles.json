{
  "providerPrefix": "sw2-",
  "limits": {
    "lanes": 3,
    "tasksPerLane": 4
  },
  "attention": {
    "tickSeconds": 30,
    "leadIdleMinutes": 12,
    "askRemindMinutes": 15,
    "maxReminders": 2,
    "watcherDebounceSeconds": 45,
    "watcherTimeoutSeconds": 180
  },
  "mcpServers": {},
  "roles": [
    {
      "role": "supervisor",
      "label": "Supervisor",
      "description": "Works with the Human, decides everything short of the concept, opens lanes and answers Leads",
      "entry": true,
      "harness": "claude",
      "team": "supervisor",
      "byHarness": {
        "claude": {
          "models": [
            {
              "id": "claude-opus-5",
              "label": "Opus 5",
              "isDefault": true,
              "thinkingOptions": [
                { "id": "medium", "label": "Medium" },
                { "id": "high", "label": "High", "isDefault": true }
              ]
            }
          ]
        }
      },
      "prompt": "prompts/SUPERVISOR.md",
      "skills": "supervisor",
      "extraMcpServers": {
        "figma": { "type": "http", "url": "https://mcp.figma.com/mcp" }
      },
      "paseoTools": { "allow": ["get_agent_activity", "list_pending_permissions"] },
      "hidesWords": []
    },
    {
      "role": "lead",
      "label": "Lead",
      "description": "Owns one lane: splits it into tasks, starts Peers, accepts and integrates",
      "harness": "claude",
      "team": "lead",
      "byHarness": {
        "claude": {
          "models": [
            {
              "id": "claude-opus-5",
              "label": "Opus 5",
              "isDefault": true,
              "thinkingOptions": [
                { "id": "medium", "label": "Medium", "isDefault": true },
                { "id": "high", "label": "High" }
              ]
            }
          ]
        }
      },
      "prompt": "prompts/LEAD.md",
      "skills": "lead",
      "extraMcpServers": {
        "figma": { "type": "http", "url": "https://mcp.figma.com/mcp" }
      },
      "paseoTools": { "allow": ["get_agent_activity"] },
      "hidesWords": ["supervisor", "watcher"]
    },
    {
      "role": "peer",
      "label": "Peer",
      "description": "Does one task on its own branch and hands it back",
      "harness": "devin",
      "team": "peer",
      "byHarness": {
        "devin": { "models": [{ "id": "swe-2-max", "label": "SWE-2 Max", "isDefault": true }] },
        "omp": { "models": [{ "id": "zai/glm-5.3-flash", "label": "GLM-5.3-Flash", "isDefault": true }], "thinking": "max" }
      },
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": { "enabled": false },
      "hidesWords": ["paseo", "supervisor", "watcher", "seat", "seats"]
    },
    {
      "role": "reviewer",
      "label": "Reviewer",
      "description": "Read-only Peer that reviews a task branch with clean context",
      "harness": "devin",
      "team": "reviewer",
      "byHarness": {
        "devin": { "models": [{ "id": "swe-2-max", "label": "SWE-2 Max", "isDefault": true }] },
        "omp": { "models": [{ "id": "zai/glm-5.3", "label": "GLM-5.3", "isDefault": true }], "thinking": "max" }
      },
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": ["peer:test-proof-debt-audit", "peer:security-check", "peer:diagnosing-bugs"],
      "paseoTools": { "enabled": false },
      "hidesWords": ["paseo", "supervisor", "watcher", "seat", "seats"]
    },
    {
      "role": "watcher",
      "label": "Watcher",
      "description": "Cheap model run headless by the plugin on flagged turn endings; raises attention for the Supervisor",
      "harness": "devin",
      "headless": true,
      "byHarness": {
        "devin": { "models": [{ "id": "swe-2-max", "label": "SWE-2 Max", "isDefault": true }] },
        "omp": { "models": [{ "id": "zai/glm-5.3-flash", "label": "GLM-5.3-Flash", "isDefault": true }] }
      },
      "prompt": "prompts/WATCHER.md",
      "skills": null,
      "hidesWords": []
    }
  ]
}
