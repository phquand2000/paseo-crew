{
  "providerPrefix": "sw2-",
  "limits": {
    "slots": 3,
    "tasksPerLane": 4
  },
  "attention": {
    "tickSeconds": 30,
    "leadIdleMinutes": 12,
    "askRemindMinutes": 15,
    "maxReminders": 2,
    "watcherDebounceSeconds": 45,
    "watcherTimeoutSeconds": 180
  },
  "roles": [
    {
      "role": "supervisor",
      "label": "Supervisor",
      "description": "Works with the Human, decides everything short of the concept, opens lanes and answers Leads",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5",
        "thinking": "high"
      },
      "entry": true,
      "team": "supervisor",
      "prompt": "prompts/SUPERVISOR.md",
      "skills": "supervisor",
      "paseoTools": {
        "allow": [
          "get_agent_activity",
          "list_pending_permissions"
        ]
      },
      "hidesWords": []
    },
    {
      "role": "lead",
      "label": "Lead",
      "description": "Owns one lane: splits it into tasks, starts Peers, accepts and integrates",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5",
        "thinking": "medium"
      },
      "team": "lead",
      "prompt": "prompts/LEAD.md",
      "skills": "lead",
      "paseoTools": {
        "allow": [
          "get_agent_activity"
        ]
      },
      "hidesWords": [
        "supervisor",
        "watcher"
      ]
    },
    {
      "role": "peer",
      "label": "Peer",
      "description": "Does one task on its own branch and hands it back",
      "defaults": {
        "harness": "devin",
        "model": "swe-2-max"
      },
      "team": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "watcher",
        "seat",
        "seats"
      ]
    },
    {
      "role": "reviewer",
      "label": "Reviewer",
      "description": "Read-only Peer that reviews a task branch with clean context",
      "defaults": {
        "harness": "devin",
        "model": "swe-2-max"
      },
      "team": "reviewer",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "peer:test-proof-debt-audit",
        "peer:security-check",
        "peer:diagnosing-bugs"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "watcher",
        "seat",
        "seats"
      ]
    },
    {
      "role": "watcher",
      "label": "Watcher",
      "description": "Cheap model run headless by the plugin on flagged turn endings; raises attention for the Supervisor",
      "defaults": {
        "harness": "devin",
        "model": "swe-2-max"
      },
      "headless": true,
      "prompt": "prompts/WATCHER.md",
      "skills": null,
      "hidesWords": []
    }
  ]
}
