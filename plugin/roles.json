              "isDefault": true
            }
          ],
          "thinking": "max"
        }
      },
      "prompt": "prompts/REVIEWER.md",
      "codeTools": [
        "search",
        "find_related",
        "ide_find_definition",
        "ide_find_references",
        "ide_find_implementations",
        "ide_call_hierarchy",
        "ide_type_hierarchy",
        "ide_find_symbol",
        "ide_symbol_info",
        "ide_file_structure",
        "ide_diagnostics",
        "ide_sync_files",
        "ide_find_super_methods"
      ],
      "skills": null,
      "extraSkills": [
        "peer:test-proof-debt-audit",
        "peer:security-check",
        "peer:diagnosing-bugs"
