{
  "providerPrefix": "crew-",
  "attention": {
    "tickSeconds": 30,
    "leadIdleMinutes": 12,
    "askWaitingMinutes": 15,
    "judge": "off"
  },
  "roles": [
    {
      "role": "supervisor",
      "label": "Supervisor",
      "description": "Acts for the Human: settles the goal with them, opens lanes and answers Leads; reads anything, writes no code",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "presets": {
        "codex": {
          "model": "gpt-6-astra",
          "thinking": "medium"
        }
      },
      "can": [
        "supervise"
      ],
      "tools": "supervisor",
      "prompt": "prompts/SUPERVISOR.md",
      "skills": "supervisor",
      "paseoTools": {
        "allow": [
          "create_agent",
          "send_agent_prompt",
          "archive_agent",
          "list_providers",
          "list_models"
        ]
      },
      "hidesWords": [],
      "writes": [
        "CONTEXT.md",
        "notebook.md"
      ]
    },
    {
      "role": "lead",
      "label": "Lead",
      "description": "Owns a lane: splits it into tasks, starts Peers, accepts and integrates; stays on after it closes until released",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "lead",
        "watched"
      ],
      "tools": "lead",
      "prompt": "prompts/LEAD.md",
      "skills": "lead",
      "paseoTools": {
        "allow": [
          "create_agent",
          "send_agent_prompt",
          "archive_agent",
          "list_providers",
          "list_models"
        ]
      },
      "hidesWords": [
        "supervisor",
        "peer",
        "peers",
        "turn",
        "desk",
        "seat",
        "seats"
      ],
      "writes": [
        "plans/",
        "ultra-review/",
        "repo-refresh/"
      ]
    },
    {
      "role": "peer",
      "label": "Peer",
      "description": "Does one task for its Lead, finding where the change goes, and hands it back; stays until released",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "work",
        "write",
        "watched"
      ],
      "tools": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats",
        "peer",
        "peers",
        "turn",
        "desk"
      ]
    },
    {
      "role": "backup-peer",
      "label": "Backup Peer",
      "description": "Does a Peer's task on another agent, for when the Peer's is out of quota",
      "defaults": {
        "harness": "codex",
        "model": "gpt-5.6-luna",
        "thinking": "max"
      },
      "can": [
        "work",
        "write",
        "watched"
      ],
      "tools": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats",
        "peer",
        "peers",
        "turn",
        "desk"
      ]
    },
    {
      "role": "reviewer",
      "label": "Reviewer",
      "description": "Read-only Peer that reviews a task branch with clean context",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "reviewer:security-check"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats",
        "peer",
        "peers",
        "turn",
        "desk"
      ]
    },
    {
      "role": "senior-reviewer",
      "label": "Senior Reviewer",
      "description": "Read-only Peer that reviews complex changes and a lane before it closes, on a stronger model",
      "defaults": {
        "harness": "codex",
        "model": "gpt-6-astra",
        "thinking": "high"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "reviewer:security-check"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats",
        "peer",
        "peers",
        "turn",
        "desk"
      ]
    },
    {
      "role": "pager",
      "label": "Pager",
      "description": "Carries a page to the Human: says back the lines the desk gives it, and Paseo pushes them to their phone",
      "defaults": {
        "harness": "claude",
        "model": "claude-haiku-4-5"
      },
      "can": [
        "page"
      ],
      "prompt": "prompts/PAGER.md",
      "skills": null,
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": []
    }
  ]
}
