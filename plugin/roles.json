{
  "providerPrefix": "sw2-",
  "attention": {
    "tickSeconds": 30,
    "leadIdleMinutes": 12,
    "askRemindMinutes": 15,
    "maxReminders": 2
  },
  "roles": [
    {
      "role": "supervisor",
      "label": "Supervisor",
      "description": "Works with the Human, decides everything short of the concept, opens lanes and answers Leads",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5",
        "thinking": "high"
      },
      "can": [
        "supervise"
      ],
      "tools": "supervisor",
      "prompt": "prompts/SUPERVISOR.md",
      "skills": "supervisor",
      "paseoTools": {
        "allow": [
          "get_agent_activity",
          "list_pending_permissions",
          "create_heartbeat",
          "delete_heartbeat",
          "list_schedules"
        ]
      },
      "hidesWords": []
    },
    {
      "role": "lead",
      "label": "Lead",
      "description": "Owns one lane: splits it into tasks, starts Peers, accepts and integrates",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5",
        "thinking": "medium"
      },
      "can": [
        "lead",
        "watched"
      ],
      "tools": "lead",
      "prompt": "prompts/LEAD.md",
      "skills": "lead",
      "paseoTools": {
        "allow": [
          "get_agent_activity"
        ]
      },
      "hidesWords": [
        "supervisor"
      ]
    },
    {
      "role": "peer",
      "label": "Peer",
      "description": "Does one task and hands it back",
      "defaults": {
        "harness": "devin",
        "model": "swe-2-max"
      },
      "can": [
        "work",
        "write",
        "watched"
      ],
      "tools": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "reviewer",
      "label": "Reviewer",
      "description": "Read-only Peer that reviews a task branch with clean context",
      "defaults": {
        "harness": "devin",
        "model": "swe-2-max"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "peer:test-proof-debt-audit"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    }
  ]
}
