{
  "_doc": [
    "These four entries belong under .agents.providers in ~/.paseo/config.json.",
    "Merge them into the existing file; don't replace it, because it also holds workspaces and the agent ledger.",
    "Replace HOME_DIR with the real home directory and OAUTH_TOKEN with your CLAUDE_CODE_OAUTH_TOKEN.",
    "The Supervisor defaults to a cheaper model because it runs rarely and mostly reads; keep Opus for hard meetings.",
    "Delete the _doc key before writing: Paseo's schema rejects unknown keys."
  ],

  "claude": {
    "env": { "CLAUDE_CODE_OAUTH_TOKEN": "OAUTH_TOKEN" },
    "enabled": true
  },

  "claude-lead": {
    "extends": "claude",
    "label": "Claude Lead Seat",
    "description": "Lead seat: framing, delegation, review, acceptance",
    "env": {
      "CLAUDE_CONFIG_DIR": "HOME_DIR/.claude/profiles/claude-lead",
      "CLAUDE_CODE_OAUTH_TOKEN": "OAUTH_TOKEN",
      "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1",
      "CLAUDE_CODE_DISABLE_CRON": "1",
      "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
      "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
      "CLAUDE_CODE_DISABLE_WORKFLOWS": "1",
      "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1"
    },
    "models": [
      {
        "id": "claude-opus-5",
        "label": "Opus 5",
        "isDefault": true,
        "thinkingOptions": [
          { "id": "low", "label": "Low" },
          { "id": "medium", "label": "Medium", "isDefault": true },
          { "id": "high", "label": "High" }
        ]
      }
    ],
    "disallowedTools": []
  },

  "claude-peer": {
    "extends": "claude",
    "label": "Claude Peer Seat",
    "description": "Peer seat: implementation, evidence, handoff",
    "env": {
      "CLAUDE_CONFIG_DIR": "HOME_DIR/.claude/profiles/claude-peer",
      "CLAUDE_CODE_OAUTH_TOKEN": "OAUTH_TOKEN",
      "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1",
      "CLAUDE_CODE_DISABLE_CRON": "1",
      "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
      "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
      "CLAUDE_CODE_DISABLE_WORKFLOWS": "1",
      "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1"
    },
    "models": [
      {
        "id": "claude-opus-5",
        "label": "Opus 5",
        "isDefault": true,
        "thinkingOptions": [
          { "id": "low", "label": "Low" },
          { "id": "medium", "label": "Medium", "isDefault": true },
          { "id": "high", "label": "High" }
        ]
      }
    ],
    "disallowedTools": []
  },

  "claude-supervisor": {
    "extends": "claude",
    "label": "Claude Supervisor Seat",
    "description": "Supervisor seat: meets the Human, relays decisions, observes, keeps the notebook",
    "env": {
      "CLAUDE_CONFIG_DIR": "HOME_DIR/.claude/profiles/claude-supervisor",
      "CLAUDE_CODE_OAUTH_TOKEN": "OAUTH_TOKEN",
      "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1",
      "CLAUDE_CODE_DISABLE_CRON": "1",
      "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
      "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
      "CLAUDE_CODE_DISABLE_WORKFLOWS": "1",
      "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1"
    },
    "models": [
      {
        "id": "claude-sonnet-5",
        "label": "Sonnet 5",
        "isDefault": true,
        "thinkingOptions": [
          { "id": "low", "label": "Low" },
          { "id": "medium", "label": "Medium", "isDefault": true },
          { "id": "high", "label": "High" }
        ]
      },
      {
        "id": "claude-opus-5",
        "label": "Opus 5",
        "thinkingOptions": [
          { "id": "medium", "label": "Medium", "isDefault": true },
          { "id": "high", "label": "High" }
        ]
      }
    ],
    "disallowedTools": []
  }
}
